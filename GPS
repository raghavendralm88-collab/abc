<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>PCCS GPS Tracker</title>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #0a1628;
  --surface: #0f2040;
  --surface2: #162a4a;
  --border: #1e3a5a;
  --accent: #e8a020;
  --blue: #1a6bbf;
  --blue2: #4fc3f7;
  --green: #27ae60;
  --red: #e74c3c;
  --text: #e8f0fe;
  --muted: #7aa0c0;
  --radius: 14px;
}

body {
  font-family: 'Segoe UI', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  overflow-x: hidden;
}

/* ── SCREENS ── */
.screen { display: none; min-height: 100vh; flex-direction: column; }
.screen.active { display: flex; }

/* ── LOGIN SCREEN ── */
#screen-login {
  align-items: center;
  justify-content: center;
  padding: 24px;
  position: relative;
  overflow: hidden;
}
#screen-login::before {
  content: '';
  position: fixed;
  top: -40%; left: -20%;
  width: 80vw; height: 80vw;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(26,107,191,0.12) 0%, transparent 70%);
  pointer-events: none;
}
#screen-login::after {
  content: '';
  position: fixed;
  bottom: -30%; right: -20%;
  width: 60vw; height: 60vw;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,160,32,0.08) 0%, transparent 70%);
  pointer-events: none;
}

.login-box {
  width: 100%; max-width: 400px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 32px 28px;
  position: relative;
  z-index: 1;
}

.brand {
  display: flex; align-items: center; gap: 14px;
  margin-bottom: 28px;
}
.brand-logo {
  width: 52px; height: 52px;
  background: var(--accent);
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  font-size: 26px;
  flex-shrink: 0;
}
.brand-name { font-size: 20px; font-weight: 700; color: #fff; line-height: 1.2; }
.brand-sub { font-size: 12px; color: var(--muted); margin-top: 2px; }

.firebase-setup {
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 20px;
}
.firebase-setup summary {
  font-size: 12px; color: var(--muted);
  cursor: pointer; user-select: none;
  display: flex; align-items: center; gap: 6px;
}
.firebase-setup summary::marker { display: none; }
.firebase-setup[open] summary { color: var(--blue2); margin-bottom: 12px; }
.firebase-url-input {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 12px;
  color: var(--text);
  font-size: 12px;
  font-family: monospace;
  outline: none;
  margin-top: 8px;
  transition: border-color 0.2s;
}
.firebase-url-input:focus { border-color: var(--blue2); }
.firebase-hint { font-size: 11px; color: var(--muted); margin-top: 6px; line-height: 1.5; }

.role-tabs {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 8px; margin-bottom: 20px;
}
.role-tab {
  padding: 14px 10px;
  border: 1.5px solid var(--border);
  border-radius: 12px;
  text-align: center;
  cursor: pointer;
  transition: all 0.2s;
  background: var(--bg);
}
.role-tab:hover { border-color: var(--blue); }
.role-tab.selected { border-color: var(--blue); background: rgba(26,107,191,0.12); }
.role-tab.selected.delivery { border-color: var(--accent); background: rgba(232,160,32,0.1); }
.role-tab .tab-icon { font-size: 24px; margin-bottom: 6px; }
.role-tab .tab-label { font-size: 13px; font-weight: 600; color: var(--text); }
.role-tab .tab-desc { font-size: 11px; color: var(--muted); margin-top: 2px; }

.form-group { margin-bottom: 14px; }
.form-label { font-size: 12px; color: var(--muted); margin-bottom: 6px; display: block; }
.form-input {
  width: 100%;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  color: var(--text);
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s;
}
.form-input:focus { border-color: var(--blue2); }

.btn-login {
  width: 100%; padding: 14px;
  border: none; border-radius: 12px;
  font-size: 15px; font-weight: 700;
  cursor: pointer;
  transition: all 0.2s;
  margin-top: 4px;
  letter-spacing: 0.3px;
}
.btn-login.coordinator { background: var(--blue); color: white; }
.btn-login.coordinator:hover { background: #145a9e; }
.btn-login.delivery { background: var(--accent); color: #0a1628; }
.btn-login.delivery:hover { background: #d4901c; }
.btn-login:disabled { opacity: 0.5; cursor: not-allowed; }

.login-error {
  font-size: 12px; color: var(--red);
  text-align: center; margin-top: 10px;
  min-height: 18px;
}

/* ── HEADER ── */
.app-header {
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 12px 16px;
  display: flex; align-items: center; justify-content: space-between;
  flex-shrink: 0;
}
.app-header-left { display: flex; align-items: center; gap: 10px; }
.header-logo {
  width: 34px; height: 34px;
  background: var(--accent);
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
}
.header-title { font-size: 15px; font-weight: 700; color: #fff; }
.header-sub { font-size: 11px; color: var(--muted); }
.header-right { display: flex; align-items: center; gap: 8px; }
.live-pill {
  display: flex; align-items: center; gap: 5px;
  background: rgba(39,174,96,0.15);
  border: 1px solid rgba(39,174,96,0.3);
  border-radius: 20px;
  padding: 4px 10px;
  font-size: 11px; color: var(--green); font-weight: 600;
}
.live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: blink 1.2s infinite; }
@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

.logout-btn {
  background: none; border: 1px solid var(--border);
  border-radius: 8px; padding: 5px 10px;
  color: var(--muted); font-size: 12px; cursor: pointer;
  transition: all 0.2s;
}
.logout-btn:hover { border-color: var(--red); color: var(--red); }

/* ── DELIVERY BOY SCREEN ── */
#screen-delivery { background: var(--bg); }
.delivery-body { flex: 1; padding: 16px; display: flex; flex-direction: column; gap: 14px; overflow-y: auto; }

.pulse-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px 20px;
  display: flex; flex-direction: column; align-items: center;
  gap: 12px;
}
.pulse-ring {
  width: 130px; height: 130px;
  border-radius: 50%;
  background: var(--bg);
  border: 3px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: 40px;
  transition: all 0.4s;
  position: relative;
}
.pulse-ring.sharing {
  border-color: var(--green);
  box-shadow: 0 0 0 0 rgba(39,174,96,0.4);
  animation: ripple 1.8s infinite;
}
.pulse-ring.error { border-color: var(--red); }
@keyframes ripple {
  0% { box-shadow: 0 0 0 0 rgba(39,174,96,0.4); }
  70% { box-shadow: 0 0 0 20px rgba(39,174,96,0); }
  100% { box-shadow: 0 0 0 0 rgba(39,174,96,0); }
}
.pulse-status { font-size: 16px; font-weight: 700; color: #fff; text-align: center; }
.pulse-sub { font-size: 12px; color: var(--muted); text-align: center; }
.update-badge {
  background: rgba(79,195,247,0.1);
  border: 1px solid rgba(79,195,247,0.2);
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 11px;
  color: var(--blue2);
}

.coords-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
.coord-box {
  background: var(--bg);
  border-radius: 10px;
  padding: 10px 12px;
  text-align: center;
}
.coord-lbl { font-size: 10px; color: var(--muted); margin-bottom: 4px; text-transform: uppercase; }
.coord-num { font-size: 13px; font-weight: 600; color: var(--blue2); font-family: monospace; }

.acc-row { display: flex; align-items: center; gap: 10px; width: 100%; }
.acc-lbl { font-size: 12px; color: var(--muted); white-space: nowrap; }
.acc-bar { flex: 1; height: 5px; background: var(--border); border-radius: 3px; overflow: hidden; }
.acc-fill { height: 100%; background: var(--green); border-radius: 3px; transition: width 0.5s; width: 0; }
.acc-num { font-size: 12px; color: var(--text); min-width: 38px; text-align: right; }

.btn-share {
  width: 100%; padding: 16px;
  border: none; border-radius: 14px;
  font-size: 16px; font-weight: 700;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  transition: all 0.2s;
  letter-spacing: 0.3px;
}
.btn-share.start { background: var(--green); color: white; }
.btn-share.start:hover { background: #1e8449; }
.btn-share.start:disabled { background: #1e4d35; color: #4a8c63; cursor: not-allowed; }
.btn-share.stop { background: var(--red); color: white; }
.btn-share.stop:hover { background: #c0392b; }

.info-strip {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 16px;
  font-size: 13px; color: var(--muted);
  line-height: 1.7;
}
.info-strip strong { color: var(--text); }

/* ── COORDINATOR SCREEN ── */
#screen-coordinator { background: var(--bg); }

.stats-row {
  display: grid; grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.stat-box {
  background: var(--surface);
  padding: 12px 8px;
  text-align: center;
  border-right: 1px solid var(--border);
}
.stat-box:last-child { border-right: none; }
.stat-num { font-size: 22px; font-weight: 800; color: var(--blue2); }
.stat-num.green { color: var(--green); }
.stat-num.muted { color: var(--muted); }
.stat-lbl { font-size: 10px; color: var(--muted); margin-top: 2px; text-transform: uppercase; letter-spacing: 0.4px; }

.map-section {
  position: relative;
  height: 300px;
  flex-shrink: 0;
  background: var(--surface2);
  border-bottom: 1px solid var(--border);
}
.map-section iframe { width: 100%; height: 100%; border: none; display: block; }
.map-empty-state {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  height: 100%; gap: 10px;
  color: var(--muted); font-size: 13px; text-align: center;
  padding: 20px;
}
.map-empty-state .big-icon { font-size: 44px; }
.map-chip {
  position: absolute; top: 10px; left: 10px;
  background: rgba(10,22,40,0.88);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 5px 12px;
  font-size: 11px; color: var(--blue2);
  pointer-events: none;
  backdrop-filter: blur(4px);
}

.drivers-panel { flex: 1; overflow-y: auto; padding: 14px; }
.panel-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12px;
}
.panel-title { font-size: 12px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
.refresh-btn {
  background: none; border: 1px solid var(--border);
  border-radius: 8px; padding: 5px 10px;
  color: var(--muted); font-size: 12px; cursor: pointer;
  transition: all 0.2s;
}
.refresh-btn:hover { border-color: var(--blue2); color: var(--blue2); }

.driver-list { display: flex; flex-direction: column; gap: 10px; }
.driver-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 16px;
  display: flex; align-items: center; gap: 12px;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
}
.driver-card:hover { border-color: var(--blue); background: rgba(26,107,191,0.06); }
.driver-card.focused { border-color: var(--green); background: rgba(39,174,96,0.06); }

.avatar {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--blue);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
  position: relative;
}
.avatar.delivery-role { background: rgba(232,160,32,0.2); }
.status-badge {
  position: absolute; bottom: 0; right: 0;
  width: 13px; height: 13px;
  border-radius: 50%;
  border: 2px solid var(--surface);
}
.badge-on { background: var(--green); }
.badge-off { background: var(--muted); }

.driver-info { flex: 1; min-width: 0; }
.d-name { font-size: 14px; font-weight: 600; color: #fff; margin-bottom: 3px; }
.d-coords { font-size: 11px; color: var(--muted); font-family: monospace; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.d-meta { display: flex; gap: 10px; margin-top: 3px; }
.d-time { font-size: 11px; color: var(--blue2); }
.d-acc { font-size: 11px; color: var(--muted); }

.track-btn {
  background: var(--blue);
  color: white; border: none;
  border-radius: 8px; padding: 7px 12px;
  font-size: 12px; font-weight: 600;
  cursor: pointer; flex-shrink: 0;
  transition: background 0.2s;
}
.track-btn:hover { background: #145a9e; }

.empty-drivers {
  text-align: center; color: var(--muted);
  font-size: 13px; padding: 30px 20px; line-height: 1.8;
}

/* ── TOAST ── */
.toast {
  position: fixed; bottom: 24px; left: 50%;
  transform: translateX(-50%);
  background: var(--surface2);
  border: 1px solid var(--border);
  color: var(--text);
  padding: 10px 20px;
  border-radius: 20px;
  font-size: 13px;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
  z-index: 9999;
  white-space: nowrap;
  max-width: 90vw;
}
.toast.show { opacity: 1; }
</style>
</head>
<body>

<!-- ══════════════ LOGIN SCREEN ══════════════ -->
<div id="screen-login" class="screen active">
  <div class="login-box">
    <div class="brand">
      <div class="brand-logo">🚚</div>
      <div>
        <div class="brand-name">PCCS GPS Tracker</div>
        <div class="brand-sub">Live delivery tracking system</div>
      </div>
    </div>

    <details class="firebase-setup" id="firebase-details">
      <summary>⚙️ Firebase Setup <span style="margin-left:auto;font-size:10px;">tap to configure</span></summary>
      <input class="firebase-url-input" id="firebase-url" type="text"
        placeholder="https://your-project-default-rtdb.firebaseio.com"
        oninput="saveFirebaseUrl()" />
      <div class="firebase-hint">
        Get from Firebase Console → Realtime Database → Copy URL.<br>
        Saved automatically in your browser.
      </div>
    </details>

    <div class="role-tabs">
      <div class="role-tab" id="tab-coordinator" onclick="selectRole('coordinator')">
        <div class="tab-icon">🗺️</div>
        <div class="tab-label">Coordinator</div>
        <div class="tab-desc">Track all drivers</div>
      </div>
      <div class="role-tab delivery" id="tab-delivery" onclick="selectRole('delivery')">
        <div class="tab-icon">🚴</div>
        <div class="tab-label">Delivery Boy</div>
        <div class="tab-desc">Share my location</div>
      </div>
    </div>

    <div id="login-fields">
      <div class="form-group">
        <label class="form-label" id="name-label">Your Name</label>
        <input class="form-input" id="input-name" type="text" placeholder="Enter your name" />
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input class="form-input" id="input-password" type="password" placeholder="Enter password"
          onkeydown="if(event.key==='Enter') doLogin()" />
      </div>
    </div>

    <button class="btn-login coordinator" id="btn-login" onclick="doLogin()">Login</button>
    <div class="login-error" id="login-error"></div>
  </div>
</div>

<!-- ══════════════ DELIVERY BOY SCREEN ══════════════ -->
<div id="screen-delivery" class="screen">
  <div class="app-header">
    <div class="app-header-left">
      <div class="header-logo">🚴</div>
      <div>
        <div class="header-title" id="delivery-header-name">Driver</div>
        <div class="header-sub">Delivery Boy</div>
      </div>
    </div>
    <div class="header-right">
      <div class="live-pill" id="delivery-live-pill" style="display:none;">
        <div class="live-dot"></div> LIVE
      </div>
      <button class="logout-btn" onclick="logout()">Logout</button>
    </div>
  </div>

  <div class="delivery-body">
    <div class="pulse-card">
      <div class="pulse-ring" id="pulse-ring">📍</div>
      <div class="pulse-status" id="pulse-status">Ready to share</div>
      <div class="pulse-sub" id="pulse-sub">Press Start to share your location</div>
      <div class="update-badge" id="update-badge" style="display:none;">Update #<span id="update-count">0</span></div>

      <div class="coords-grid" id="coords-grid" style="display:none;">
        <div class="coord-box">
          <div class="coord-lbl">Latitude</div>
          <div class="coord-num" id="d-lat">--</div>
        </div>
        <div class="coord-box">
          <div class="coord-lbl">Longitude</div>
          <div class="coord-num" id="d-lng">--</div>
        </div>
      </div>

      <div class="acc-row" style="width:100%;">
        <div class="acc-lbl">GPS Accuracy</div>
        <div class="acc-bar"><div class="acc-fill" id="acc-fill"></div></div>
        <div class="acc-num" id="acc-num">--</div>
      </div>
    </div>

    <button class="btn-share start" id="btn-start" onclick="startSharing()">
      📡 Start Sharing Location
    </button>
    <button class="btn-share stop" id="btn-stop" onclick="stopSharing()" style="display:none;">
      ⏹ Stop Sharing
    </button>

    <div class="info-strip">
      <strong>Tips:</strong> Keep this tab open while delivering. Screen stays on automatically. Location updates every few seconds to coordinator.
    </div>
  </div>
</div>

<!-- ══════════════ COORDINATOR SCREEN ══════════════ -->
<div id="screen-coordinator" class="screen">
  <div class="app-header">
    <div class="app-header-left">
      <div class="header-logo">🗺️</div>
      <div>
        <div class="header-title" id="coord-header-name">Coordinator</div>
        <div class="header-sub">Live Tracking Dashboard</div>
      </div>
    </div>
    <div class="header-right">
      <div class="live-pill"><div class="live-dot"></div> LIVE</div>
      <button class="logout-btn" onclick="logout()">Logout</button>
    </div>
  </div>

  <div class="stats-row">
    <div class="stat-box">
      <div class="stat-num" id="s-total">0</div>
      <div class="stat-lbl">Total</div>
    </div>
    <div class="stat-box">
      <div class="stat-num green" id="s-active">0</div>
      <div class="stat-lbl">Active</div>
    </div>
    <div class="stat-box">
      <div class="stat-num muted" id="s-offline">0</div>
      <div class="stat-lbl">Offline</div>
    </div>
  </div>

  <div class="map-section" id="map-section">
    <div class="map-empty-state" id="map-empty">
      <div class="big-icon">📡</div>
      <div>No active drivers yet</div>
      <div style="font-size:12px;">Drivers will appear here when they start sharing</div>
    </div>
    <iframe id="map-frame" src="" style="display:none;"></iframe>
    <div class="map-chip" id="map-chip" style="display:none;"></div>
  </div>

  <div class="drivers-panel">
    <div class="panel-header">
      <div class="panel-title">Delivery Boys</div>
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:11px;color:var(--muted);" id="last-updated">--</span>
        <button class="refresh-btn" onclick="showToast('Auto-refreshing every 5s ✓')">↻ Auto</button>
      </div>
    </div>
    <div class="driver-list" id="driver-list">
      <div class="empty-drivers">Connect to Firebase and wait for drivers to log in.</div>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<!-- Firebase SDK -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/9.23.0/firebase-app-compat.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/firebase/9.23.0/firebase-database-compat.min.js"></script>

<script>
// ── CONFIG ──────────────────────────────────────────────
// Passwords — change these!
const PASSWORDS = {
  coordinator: 'pccs@coord2024',
  delivery: 'pccs@driver2024'
};

// ── STATE ────────────────────────────────────────────────
let db = null;
let currentRole = 'coordinator';
let currentUser = '';
let watchId = null;
let updateCount = 0;
let driversData = {};
let focusedDriver = null;
let firebaseApp = null;

// ── FIREBASE ─────────────────────────────────────────────
function getFirebaseUrl() {
  return localStorage.getItem('pccs_firebase_url') || '';
}
function saveFirebaseUrl() {
  const v = document.getElementById('firebase-url').value.trim();
  if (v) localStorage.setItem('pccs_firebase_url', v);
}
function initFirebase(url) {
  try {
    if (firebaseApp) {
      db = firebase.database(firebaseApp);
      return true;
    }
    firebaseApp = firebase.initializeApp({ databaseURL: url });
    db = firebase.database(firebaseApp);
    return true;
  } catch(e) {
    showToast('❌ Firebase error: ' + e.message);
    return false;
  }
}

// ── LOGIN ─────────────────────────────────────────────────
function selectRole(role) {
  currentRole = role;
  document.getElementById('tab-coordinator').classList.toggle('selected', role === 'coordinator');
  document.getElementById('tab-delivery').classList.toggle('selected', role === 'delivery');
  document.getElementById('btn-login').className = 'btn-login ' + role;
  document.getElementById('btn-login').textContent = role === 'coordinator' ? '🗺️ Login as Coordinator' : '🚴 Login as Delivery Boy';
  document.getElementById('name-label').textContent = role === 'coordinator' ? 'Your Name' : 'Driver Name';
  document.getElementById('login-error').textContent = '';
}

function doLogin() {
  const name = document.getElementById('input-name').value.trim();
  const pass = document.getElementById('input-password').value;
  const fbUrl = document.getElementById('firebase-url').value.trim() || getFirebaseUrl();

  if (!name) { showLoginError('Please enter your name'); return; }
  if (!pass) { showLoginError('Please enter password'); return; }
  if (!fbUrl || !fbUrl.startsWith('https://')) {
    document.getElementById('firebase-details').open = true;
    showLoginError('Please enter Firebase Database URL above ↑'); return;
  }
  if (pass !== PASSWORDS[currentRole]) {
    showLoginError('❌ Wrong password. Try again.'); return;
  }

  if (!initFirebase(fbUrl)) return;

  currentUser = name;
  document.getElementById('login-error').textContent = '';

  if (currentRole === 'coordinator') {
    document.getElementById('coord-header-name').textContent = name;
    showScreen('coordinator');
    startCoordinatorListening();
  } else {
    document.getElementById('delivery-header-name').textContent = name;
    showScreen('delivery');
  }
  showToast('✅ Welcome, ' + name + '!');
}

function showLoginError(msg) {
  document.getElementById('login-error').textContent = msg;
}

function logout() {
  stopSharing();
  if (db && currentRole === 'delivery') {
    const key = userKey();
    db.ref('drivers/' + key + '/status').set('offline').catch(()=>{});
  }
  currentUser = '';
  watchId = null;
  updateCount = 0;
  driversData = {};
  focusedDriver = null;
  document.getElementById('input-name').value = '';
  document.getElementById('input-password').value = '';
  resetDeliveryUI();
  showScreen('login');
}

// ── SCREENS ───────────────────────────────────────────────
function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + name).classList.add('active');
}

// ── DELIVERY BOY ──────────────────────────────────────────
function userKey() {
  return currentUser.replace(/\s+/g, '_').toLowerCase();
}

function startSharing() {
  if (!navigator.geolocation) {
    showToast('❌ GPS not supported on this device');
    return;
  }
  document.getElementById('btn-start').disabled = true;
  document.getElementById('btn-start').textContent = '⏳ Getting GPS...';

  navigator.geolocation.getCurrentPosition(pos => {
    onDeliveryPosition(pos);
    watchId = navigator.geolocation.watchPosition(onDeliveryPosition, onGPSError, {
      enableHighAccuracy: true, maximumAge: 5000, timeout: 20000
    });
    document.getElementById('btn-start').style.display = 'none';
    document.getElementById('btn-stop').style.display = 'flex';
    document.getElementById('delivery-live-pill').style.display = 'flex';
    if ('wakeLock' in navigator) navigator.wakeLock.request('screen').catch(()=>{});
  }, onGPSError, { enableHighAccuracy: true, timeout: 15000 });
}

function onDeliveryPosition(pos) {
  const lat = pos.coords.latitude;
  const lng = pos.coords.longitude;
  const acc = Math.round(pos.coords.accuracy);
  updateCount++;

  if (db) {
    db.ref('drivers/' + userKey()).set({
      name: currentUser,
      lat, lng,
      accuracy: acc,
      timestamp: Date.now(),
      status: 'active'
    }).catch(e => showToast('⚠️ Upload failed'));
  }

  document.getElementById('pulse-ring').className = 'pulse-ring sharing';
  document.getElementById('pulse-ring').textContent = '📍';
  document.getElementById('pulse-status').textContent = '✅ Sharing Live Location';
  document.getElementById('pulse-sub').textContent = 'Coordinator can see you now';
  document.getElementById('update-badge').style.display = 'block';
  document.getElementById('update-count').textContent = updateCount;
  document.getElementById('coords-grid').style.display = 'grid';
  document.getElementById('d-lat').textContent = lat.toFixed(6);
  document.getElementById('d-lng').textContent = lng.toFixed(6);
  document.getElementById('acc-num').textContent = acc + 'm';
  const pct = Math.max(5, Math.min(100, 100 - (acc / 100 * 100)));
  document.getElementById('acc-fill').style.width = pct + '%';
}

function onGPSError(err) {
  document.getElementById('btn-start').disabled = false;
  document.getElementById('btn-start').textContent = '📡 Start Sharing Location';
  document.getElementById('btn-start').style.display = 'flex';
  document.getElementById('btn-stop').style.display = 'none';
  document.getElementById('pulse-ring').className = 'pulse-ring error';
  document.getElementById('pulse-status').textContent = 'GPS Error';
  document.getElementById('pulse-sub').textContent = err.message;
  showToast('❌ GPS error: ' + err.message);
}

function stopSharing() {
  if (watchId) { navigator.geolocation.clearWatch(watchId); watchId = null; }
  if (db && currentUser) {
    db.ref('drivers/' + userKey() + '/status').set('offline').catch(()=>{});
  }
  resetDeliveryUI();
}

function resetDeliveryUI() {
  updateCount = 0;
  document.getElementById('pulse-ring').className = 'pulse-ring';
  document.getElementById('pulse-ring').textContent = '📍';
  document.getElementById('pulse-status').textContent = 'Ready to share';
  document.getElementById('pulse-sub').textContent = 'Press Start to share your location';
  document.getElementById('update-badge').style.display = 'none';
  document.getElementById('coords-grid').style.display = 'none';
  document.getElementById('acc-fill').style.width = '0';
  document.getElementById('acc-num').textContent = '--';
  document.getElementById('btn-start').style.display = 'flex';
  document.getElementById('btn-start').disabled = false;
  document.getElementById('btn-start').textContent = '📡 Start Sharing Location';
  document.getElementById('btn-stop').style.display = 'none';
  document.getElementById('delivery-live-pill').style.display = 'none';
}

// ── COORDINATOR ───────────────────────────────────────────
function startCoordinatorListening() {
  db.ref('drivers').on('value', snapshot => {
    driversData = snapshot.val() || {};
    renderDriverList();
    updateStats();
    updateMapForFocused();
    document.getElementById('last-updated').textContent = 'Updated ' + new Date().toLocaleTimeString();
  });
}

function isOnline(d) {
  return d.status === 'active' && (Date.now() - d.timestamp) < 90000;
}

function timeAgo(ts) {
  const s = Math.round((Date.now() - ts) / 1000);
  if (s < 10) return 'just now';
  if (s < 60) return s + 's ago';
  if (s < 3600) return Math.round(s/60) + 'm ago';
  return Math.round(s/3600) + 'h ago';
}

function updateStats() {
  const keys = Object.keys(driversData);
  const active = keys.filter(k => isOnline(driversData[k])).length;
  document.getElementById('s-total').textContent = keys.length;
  document.getElementById('s-active').textContent = active;
  document.getElementById('s-offline').textContent = keys.length - active;
}

function renderDriverList() {
  const list = document.getElementById('driver-list');
  const keys = Object.keys(driversData);
  if (!keys.length) {
    list.innerHTML = '<div class="empty-drivers">No drivers logged in yet.<br>Share this app link with your delivery team.</div>';
    return;
  }
  keys.sort((a,b) => (driversData[b].timestamp||0) - (driversData[a].timestamp||0));
  list.innerHTML = keys.map(k => {
    const d = driversData[k];
    const online = isOnline(d);
    const focused = focusedDriver === k;
    return `<div class="driver-card${focused?' focused':''}" onclick="focusDriver('${k}')">
      <div class="avatar delivery-role">
        🧑
        <div class="status-badge ${online?'badge-on':'badge-off'}"></div>
      </div>
      <div class="driver-info">
        <div class="d-name">${d.name || k}</div>
        <div class="d-coords">${d.lat ? d.lat.toFixed(5)+', '+d.lng.toFixed(5) : 'No location yet'}</div>
        <div class="d-meta">
          <span class="d-time">${d.timestamp ? timeAgo(d.timestamp) : '--'}</span>
          <span class="d-acc">±${d.accuracy||'--'}m</span>
          <span class="d-acc">${online?'🟢 Online':'⚫ Offline'}</span>
        </div>
      </div>
      <button class="track-btn" onclick="event.stopPropagation();focusDriver('${k}')">Track</button>
    </div>`;
  }).join('');
}

function focusDriver(key) {
  focusedDriver = key;
  renderDriverList();
  updateMapForFocused();
}

function updateMapForFocused() {
  const keys = Object.keys(driversData);
  const onlineKeys = keys.filter(k => isOnline(driversData[k]));
  const target = (focusedDriver && driversData[focusedDriver]?.lat) ? focusedDriver
    : (onlineKeys[0] || null);

  if (!target || !driversData[target]?.lat) {
    document.getElementById('map-empty').style.display = 'flex';
    document.getElementById('map-frame').style.display = 'none';
    document.getElementById('map-chip').style.display = 'none';
    return;
  }

  const d = driversData[target];
  const url = `https://maps.google.com/maps?q=${d.lat},${d.lng}&z=16&output=embed`;
  const frame = document.getElementById('map-frame');
  if (frame.src !== url) frame.src = url;
  frame.style.display = 'block';
  document.getElementById('map-empty').style.display = 'none';
  const chip = document.getElementById('map-chip');
  chip.style.display = 'block';
  chip.textContent = '📍 ' + (d.name||target) + ' · ' + timeAgo(d.timestamp);
}

// ── TOAST ─────────────────────────────────────────────────
function showToast(msg, dur=3000) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), dur);
}

// ── INIT ──────────────────────────────────────────────────
(function init() {
  selectRole('coordinator');
  const saved = getFirebaseUrl();
  if (saved) document.getElementById('firebase-url').value = saved;
})();
</script>
